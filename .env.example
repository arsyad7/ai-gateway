# ---- Required ----
# SQLite by default. For Postgres: postgresql://user:pass@host:5432/gateway
DATABASE_URL="file:./dev.db"

# Password for the dashboard login page.
ADMIN_PASSWORD="change-me"

# Signs the dashboard session cookie. Generate: openssl rand -hex 32
SESSION_SECRET="replace-with-32-byte-hex"

# Encrypts provider API keys at rest (AES-256-GCM). Generate: openssl rand -hex 32
# WARNING: changing this makes already-stored provider keys unreadable.
ENCRYPTION_KEY="replace-with-32-byte-hex"

# ---- Optional: seed these and the seed script auto-creates providers ----
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
